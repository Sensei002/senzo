export struct IconData {
    glyph: string,
    font_family: string,
}

export global Theme {
    // SENZO design tokens. Reusable components consume this palette so every
    // surface, control and state shares one consistent visual identity.
    in-out property <length> root-font-size: 16px;
    in-out property <string> font-family: "Plus Jakarta Sans";
    in-out property <int> active-preset-idx: 0;

    // SENZO midnight / cyan palette.
    in-out property <color> background: #080D11;
    in-out property <color> secondary-background: #0D171D;
    in-out property <color> primary-foreground: #F3FAFC;
    in-out property <color> secondary-foreground: #071216;
    in-out property <color> primary-accent: #22D3EE;
    in-out property <color> secondary-accent: #34D399;
    in-out property <color> tertiary-accent: #FBBF24;
    in-out property <color> quaternary-accent: #22D3EE;
    in-out property <color> overlay-color: #FFFFFF0B;
    in-out property <color> modal-color: #101920;
    in-out property <color> placeholder-color: #78939C80;

    // Values used directly by official reusable components.
    in-out property <color> surface-light: #F3FAFC;
    in-out property <color> surface-light-30: #F3FAFC4D;
    in-out property <color> surface-light-90: #F3FAFCE6;
    in-out property <color> background-dark-20: #00000033;
    in-out property <color> background-dark-40: #00000066;
    in-out property <color> secondary-variant-light: #8BEAF4;
    in-out property <color> secondary-variant-light-90: #8BEAF4E6;
    in-out property <color> primary-light: #38BFD0;

    in-out property <brush> main-gradient: @linear-gradient(
        41deg,
        #080D11 0%,
        #10212A 100%
    );
    in-out property <color> sidebar-background: #0B151B;
    in-out property <color> modal-background: Theme.modal-color;
    in-out property <color> drawer-background: Theme.background-dark-40;
    in-out property <color> control-background: Theme.overlay-color;
    in-out property <color> overlay: Theme.overlay-color;
    in-out property <color> overlay-hover: #22D3EE14;
    in-out property <color> overlay-pressed: #22D3EE20;
    in-out property <color> divider: #B8DDE51A;
    in-out property <color> scrim: Theme.background-dark-40;
    in-out property <color> accent: Theme.primary-accent;
    in-out property <color> accent-hover: #67E8F9;
    in-out property <color> info: Theme.quaternary-accent;
    in-out property <color> facebook: #1877f1;
    in-out property <color> x-social: #000000;
    in-out property <color> reddit: #ff4500;
    in-out property <color> imdb: #f5c518;
    in-out property <color> rotten-tomatoes: #fa320a;
    in-out property <color> metacritic: #ffd600;
    in-out property <color> letterboxd: #00e054;
    in-out property <color> anilist: #02a9ff;
    in-out property <color> kitsu: #fd755c;
    in-out property <color> card-background: #101B21;
    in-out property <color> card-border: #1E343D;
    in-out property <color> text-primary: Theme.primary-foreground;
    in-out property <color> text-secondary: #B8CBD1;
    in-out property <color> text-muted: #8299A2;
    
    in-out property <color> danger: #FB7185;
    in-out property <color> success: Theme.secondary-accent;
    in-out property <color> warning: #FBBF24;
    in-out property <color> focus: Theme.primary-accent;
    in-out property <color> title-bar: #0A151A;

    // Official geometry. rem based values follow root-font-size; focus and
    // scrollbar widths intentionally remain device independent pixel values.
    in-out property <length> border-radius: 0.75 * Theme.root-font-size;
    in-out property <length> compact-radius: 0.5 * Theme.root-font-size;
    in-out property <length> focus-outline-size: 2px;
    in-out property <length> scrollbar-size: 6px;
    in-out property <length> horizontal-nav-bar-size: 5.5 * Theme.root-font-size;
    in-out property <length> vertical-nav-bar-size: 6 * Theme.root-font-size;
    in-out property <float> landscape-shape-ratio: 0.5625;
    in-out property <float> poster-shape-ratio: 1.464;

    // Shared timing values from the official component styles.
    in-out property <duration> motion-fast: 140ms;
    in-out property <duration> motion-control: 200ms;
    in-out property <duration> motion-panel: 280ms;
    in-out property <duration> motion-fade-in: 360ms;
    in-out property <duration> long-press-threshold: 400ms;

    in-out property <length> outer-glow-blur: 15px;
    in-out property <color> outer-glow-color: #22D3EE40;

    // SENZO surfaces keep placeholders subdued while preserving runtime
    // theme customization for users who choose a custom palette.
    in-out property <color> skeleton-base: #ffffff1a;
    in-out property <color> skeleton-shimmer: #ffffff26;
}
