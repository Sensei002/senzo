import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PillButton, ButtonSurface } from "../components/button.slint";
import { NativeTextField } from "../components/text_input.slint";
import { ToggleSwitch } from "../components/toggle.slint";
import { SelectField } from "../components/select.slint";

export struct PluginProviderCard {
    id: string,
    name: string,
    description: string,
    repository: string,
    version: string,
    content-types: string,
    languages: string,
    formats: string,
    status: string,
    status-error: bool,
    enabled: bool,
    has-settings: bool,
    settings: string,
    testing: bool,
}

export struct PluginRepositoryCard {
    url: string,
    name: string,
    version: string,
    provider-count: int,
    enabled-count: int,
    status: string,
    status-error: bool,
    refreshing: bool,
}

component SectionHeading inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <string> title;
    in property <string> description;
    in property <string> trailing;

    height: 3.2 * root.unit;
    background: transparent;

    HorizontalLayout {
        spacing: root.unit;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 0.2 * root.unit;
            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 1.05 * root.unit;
                font-weight: 700;
            }
            Text {
                text: root.description;
                color: Theme.text-muted;
                font-size: 0.8 * root.unit;
                overflow: elide;
            }
        }
        Text {
            text: root.trailing;
            color: Theme.text-muted;
            font-size: 0.76 * root.unit;
            vertical-alignment: center;
        }
    }
}

component TinyButton inherits ButtonSurface {
    in property <length> unit: Theme.root-font-size;
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> busy: false;

    height: 2.1 * root.unit;
    border-radius: self.height / 2;
    background: self.has-hover
        ? (root.danger ? Theme.danger : Theme.overlay-hover)
        : Theme.overlay-color;
    accessible-name: root.label;

    HorizontalLayout {
        alignment: center;
        spacing: 0.35 * root.unit;

        if (root.busy) : Image {
            width: 0.95 * root.unit;
            height: 0.95 * root.unit;
            source: @image-url("../assets/images/icons/rotate.svg");
            colorize: root.danger ? Theme.background : Theme.primary-accent;
            image-fit: contain;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: (animation-tick() / 900ms) * 360deg;
        }

        Text {
            text: root.label;
            color: root.danger && root.has-hover ? Theme.background : Theme.text-primary;
            font-size: 0.72 * root.unit;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component PluginProviderRow inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <PluginProviderCard> provider;

    callback toggled(string, bool);
    callback tested(string);
    callback settings-saved(string, string);

    in-out property <string> settings-draft: root.provider.settings;
    height: root.provider.has-settings ? 13.4 * root.unit : 8.2 * root.unit;
    border-radius: Theme.border-radius;
    background: Theme.card-background;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 1.1 * root.unit;
        spacing: 0.5 * root.unit;

        HorizontalLayout {
            spacing: 0.8 * root.unit;

            Rectangle {
                width: 2.8 * root.unit;
                height: 2.8 * root.unit;
                border-radius: 0.8 * root.unit;
                background: Theme.overlay-color;

                Image {
                    width: 1.45 * root.unit;
                    height: 1.45 * root.unit;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../assets/images/icons/plugins.svg");
                    colorize: root.provider.enabled ? Theme.primary-accent : Theme.text-muted;
                    image-fit: contain;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0.15 * root.unit;
                alignment: center;

                HorizontalLayout {
                    spacing: 0.5 * root.unit;
                    Text {
                        horizontal-stretch: 1;
                        text: root.provider.name;
                        color: Theme.text-primary;
                        font-size: 0.96 * root.unit;
                        font-weight: 700;
                        overflow: elide;
                    }
                    if (root.provider.has-settings) : Rectangle {
                        height: 1.25 * root.unit;
                        width: 4.4 * root.unit;
                        border-radius: self.height / 2;
                        background: Theme.overlay-hover;
                        Text {
                            text: "SETTINGS";
                            color: Theme.primary-accent;
                            font-size: 0.55 * root.unit;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.provider.repository + "  ·  v" + root.provider.version;
                    color: Theme.text-muted;
                    font-size: 0.7 * root.unit;
                    overflow: elide;
                }
            }

            ToggleSwitch {
                checked: root.provider.enabled;
                unit: root.unit;
                active-color: Theme.primary-accent;
                toggled => { root.toggled(root.provider.id, self.checked); }
            }
        }

        Text {
            text: root.provider.description;
            color: Theme.text-secondary;
            font-size: 0.76 * root.unit;
            overflow: elide;
        }

        if (root.provider.has-settings) : HorizontalLayout {
            spacing: 0.5 * root.unit;
            NativeTextField {
                horizontal-stretch: 1;
                unit: root.unit;
                text <=> root.settings-draft;
                placeholder-text: "Provider settings JSON, for example {}";
            }
            TinyButton {
                unit: root.unit;
                width: 4.8 * root.unit;
                label: "Save";
                clicked => { root.settings-saved(root.provider.id, root.settings-draft); }
            }
        }

        HorizontalLayout {
            spacing: 0.6 * root.unit;
            Text {
                horizontal-stretch: 1;
                text: root.provider.content-types + "  ·  " + root.provider.formats;
                color: Theme.text-muted;
                font-size: 0.7 * root.unit;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.provider.status;
                color: root.provider.testing
                    ? Theme.primary-accent
                    : (root.provider.status-error ? Theme.danger : Theme.success);
                font-size: 0.7 * root.unit;
                vertical-alignment: center;
                overflow: elide;
            }
            TinyButton {
                unit: root.unit;
                width: 5.8 * root.unit;
                label: root.provider.testing ? "Testing…" : "Test";
                busy: root.provider.testing;
                enabled: !root.provider.testing;
                clicked => { root.tested(root.provider.id); }
            }
        }
    }
}

component RepositoryRow inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <PluginRepositoryCard> repository;

    callback refreshed(string);
    callback removed(string);
    callback enabled-all(string, bool);

    height: 9.5 * root.unit;
    border-radius: Theme.border-radius;
    background: Theme.card-background;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 1.1 * root.unit;
        spacing: 0.35 * root.unit;

        HorizontalLayout {
            spacing: 0.7 * root.unit;
            Text {
                horizontal-stretch: 1;
                text: root.repository.name;
                color: Theme.text-primary;
                font-size: 1.1 * root.unit;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: "v" + root.repository.version;
                color: Theme.text-muted;
                font-size: 0.78 * root.unit;
                vertical-alignment: center;
            }
            TinyButton {
                unit: root.unit;
                width: 5.8 * root.unit;
                label: root.repository.refreshing ? "Refresh…" : "Refresh";
                busy: root.repository.refreshing;
                enabled: !root.repository.refreshing;
                clicked => { root.refreshed(root.repository.url); }
            }
            TinyButton {
                unit: root.unit;
                width: 4.4 * root.unit;
                label: "Delete";
                danger: true;
                clicked => { root.removed(root.repository.url); }
            }
        }

        Text {
            text: root.repository.url;
            color: Theme.text-muted;
            font-size: 0.7 * root.unit;
            overflow: elide;
        }

        Text {
            text: root.repository.enabled-count + " of " + root.repository.provider-count
                + " enabled  ·  " + root.repository.status;
            color: root.repository.status-error ? Theme.danger : Theme.text-secondary;
            font-size: 0.72 * root.unit;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 0.5 * root.unit;

            TinyButton {
                unit: root.unit;
                width: 5.4 * root.unit;
                label: "Enable all";
                enabled: root.repository.enabled-count < root.repository.provider-count;
                clicked => { root.enabled-all(root.repository.url, true); }
            }

            TinyButton {
                unit: root.unit;
                width: 5.4 * root.unit;
                label: "Disable all";
                enabled: root.repository.enabled-count > 0;
                clicked => { root.enabled-all(root.repository.url, false); }
            }

            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component PluginsPage inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <bool> console-mode: false;
    in property <bool> master-enabled: true;
    in property <bool> group-by-repository: false;
    in property <[PluginRepositoryCard]> repositories: [];
    in property <[PluginProviderCard]> providers: [];
    in property <bool> busy: false;
    in property <bool> installing: false;
    in property <bool> refreshing-all: false;
    in property <string> status: "";
    in property <bool> status-error: false;
    in-out property <string> repository-url: "";
    // Provider list controls. CloudStream repositories can publish dozens of
    // providers, so the list is searchable and filterable instead of a wall.
    in-out property <string> provider-filter: "All";
    in property <[string]> provider-filters: [
        "All",
        "Enabled",
        "Movies",
        "Series",
        "Live TV",
        "Anime",
        "Other"
    ];
    in-out property <string> provider-query: "";
    in property <int> provider-total: 0;
    // Repository filter for the provider list. Repositories commonly publish
    // dozens of providers, so the list can be narrowed to one of them.
    in property <[string]> repository-filters: ["All repositories"];
    in-out property <string> repository-filter: "All repositories";

    callback provider-filter-changed(string);
    callback provider-query-changed(string);
    callback repository-filter-changed(string);
    callback master-changed(bool);
    callback group-changed(bool);
    callback repository-add(string);
    callback repository-refresh(string);
    callback repository-remove(string);
    callback repository-enabled(string, bool);
    callback provider-toggled(string, bool);
    callback provider-tested(string);
    callback provider-settings-saved(string, string);
    callback refresh-all;

    background: root.console-mode ? transparent : Theme.background;

    ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: root.width;

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            padding-left: root.console-mode ? 1.5 * root.unit : 2 * root.unit;
            padding-right: root.console-mode ? 1.5 * root.unit : 2 * root.unit;
            padding-top: root.console-mode ? 1.0 * root.unit : 1.5 * root.unit;
            padding-bottom: 2 * root.unit;
            spacing: 1.1 * root.unit;

            HorizontalLayout {
                spacing: root.unit;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0.25 * root.unit;
                    Text {
                        text: "Plugins";
                        color: Theme.text-primary;
                        font-size: 1.9 * root.unit;
                        font-weight: 800;
                    }
                    Text {
                        text: "Install provider repositories and choose which scrapers run when you open a title.";
                        color: Theme.text-muted;
                        font-size: 0.88 * root.unit;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 0.25 * root.unit;
                    Text {
                        text: root.master-enabled ? "ENABLED" : "DISABLED";
                        color: root.master-enabled ? Theme.success : Theme.text-muted;
                        font-size: 0.62 * root.unit;
                        font-weight: 700;
                        horizontal-alignment: right;
                    }
                    ToggleSwitch {
                        checked: root.master-enabled;
                        unit: root.unit;
                        active-color: Theme.primary-accent;
                        toggled => { root.master-changed(self.checked); }
                    }
                }
            }

            if (root.status != "") : Rectangle {
                height: 2.5 * root.unit;
                border-radius: Theme.border-radius;
                background: root.status-error ? Theme.danger : Theme.overlay-color;
                border-width: 1px;
                border-color: root.status-error ? Theme.danger : Theme.card-border;
                Text {
                    x: root.unit;
                    width: parent.width - 2 * root.unit;
                    height: parent.height;
                    text: root.status;
                    color: root.status-error ? Theme.danger : Theme.text-secondary;
                    font-size: 0.8 * root.unit;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            Rectangle {
                height: 7.4 * root.unit;
                border-radius: Theme.border-radius;
                background: Theme.card-background;
                border-width: 1px;
                border-color: Theme.card-border;

                VerticalLayout {
                    padding: 1 * root.unit;
                    spacing: 0.35 * root.unit;

                    HorizontalLayout {
                        spacing: 0.35 * root.unit;
                        Text {
                            text: root.repositories.length + " repositories";
                            color: Theme.primary-accent;
                            font-size: 0.7 * root.unit;
                            font-weight: 700;
                        }
                        Text {
                            text: root.providers.length + " providers";
                            color: Theme.quaternary-accent;
                            font-size: 0.7 * root.unit;
                            font-weight: 700;
                        }
                    }

                    HorizontalLayout {
                        spacing: 0.7 * root.unit;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0.1 * root.unit;
                            Text {
                                text: "Sort providers by repository";
                                color: Theme.text-primary;
                                font-size: 0.85 * root.unit;
                                font-weight: 600;
                            }
                            Text {
                                text: "Keep providers from the same manifest together in the installed list.";
                                color: Theme.text-muted;
                                font-size: 0.72 * root.unit;
                                overflow: elide;
                            }
                        }
                        ToggleSwitch {
                            checked: root.group-by-repository;
                            unit: root.unit;
                            active-color: Theme.primary-accent;
                            toggled => { root.group-changed(self.checked); }
                        }
                    }
                }
            }

            SectionHeading {
                unit: root.unit;
                title: "Add repository";
                description: "Paste a manifest, a repo.json index or a plugins.json list. SENZO follows the index and installs every provider it lists.";
                trailing: root.busy ? "Working…" : "";
            }

            HorizontalLayout {
                spacing: 0.7 * root.unit;
                NativeTextField {
                    horizontal-stretch: 1;
                    unit: root.unit;
                    text <=> root.repository-url;
                    enabled: !root.installing;
                    placeholder-text: "https://raw.githubusercontent.com/owner/repo/master/repo.json";
                    accepted => { root.repository-add(root.repository-url); }
                }
                PillButton {
                    unit: root.unit;
                    label: root.installing ? "Installing…" : "Install Plugin Repository";
                    primary: true;
                    enabled: root.repository-url != "" && !root.busy;
                    clicked => { root.repository-add(root.repository-url); }
                }
            }

            SectionHeading {
                unit: root.unit;
                title: "Installed repositories";
                description: "Refresh a repository to discover new providers without losing your enabled choices.";
                trailing: root.repositories.length + " installed";
            }

            if (root.repositories.length == 0) : Text {
                text: "No plugin repositories installed yet. Paste a manifest URL above to add one.";
                color: Theme.text-muted;
                font-size: 0.82 * root.unit;
                wrap: word-wrap;
            }

            for repository in root.repositories : RepositoryRow {
                unit: root.unit;
                repository: repository;
                refreshed(url) => { root.repository-refresh(url); }
                removed(url) => { root.repository-remove(url); }
                enabled-all(url, enabled) => { root.repository-enabled(url, enabled); }
            }

            HorizontalLayout {
                spacing: 0.7 * root.unit;
                SectionHeading {
                    horizontal-stretch: 1;
                    unit: root.unit;
                    title: "Providers";
                    description: "Turn individual plugin providers on or off. Disabled providers are not queried.";
                    trailing: root.provider-total > root.providers.length
                        ? root.providers.length + " of " + root.provider-total
                        : root.providers.length + " available";
                }
                PillButton {
                    unit: root.unit;
                    label: root.refreshing-all ? "Refreshing…" : "Refresh all";
                    enabled: !root.busy;
                    clicked => { root.refresh-all(); }
                }
            }

            HorizontalLayout {
                spacing: 0.7 * root.unit;
                NativeTextField {
                    horizontal-stretch: 1;
                    unit: root.unit;
                    text <=> root.provider-query;
                    placeholder-text: "Search providers, languages or content types";
                    edited => { root.provider-query-changed(self.text); }
                }
                Rectangle {
                    width: max(9 * root.unit, min(16 * root.unit, parent.width * 0.34));
                    height: 2.75 * root.unit;
                    SelectField {
                        unit: root.unit;
                        field-width: parent.width;
                        value: root.repository-filter;
                        options: root.repository-filters;
                        selected(value) => {
                            root.repository-filter = value;
                            root.repository-filter-changed(value);
                        }
                    }
                }
                Rectangle {
                    width: max(8 * root.unit, min(12 * root.unit, parent.width * 0.32));
                    height: 2.75 * root.unit;
                    SelectField {
                        unit: root.unit;
                        field-width: parent.width;
                        value: root.provider-filter;
                        options: root.provider-filters;
                        selected(value) => {
                            root.provider-filter = value;
                            root.provider-filter-changed(value);
                        }
                    }
                }
            }

            if (root.provider-total == 0) : Text {
                text: "No providers loaded. Install a repository and refresh it to fetch its provider manifest.";
                color: Theme.text-muted;
                font-size: 0.82 * root.unit;
                wrap: word-wrap;
            }

            if (root.provider-total > 0 && root.providers.length == 0) : Text {
                text: "No providers match this repository, category or search. Change the filters, or clear the search box.";
                color: Theme.text-muted;
                font-size: 0.82 * root.unit;
                wrap: word-wrap;
            }

            for provider in root.providers : PluginProviderRow {
                unit: root.unit;
                provider: provider;
                toggled(id, enabled) => { root.provider-toggled(id, enabled); }
                tested(id) => { root.provider-tested(id); }
                settings-saved(id, settings) => { root.provider-settings-saved(id, settings); }
            }

            Text {
                text: "Plugins are community-maintained scrapers that run in a sandbox with network access. SENZO does not host their content, bypass logins or DRM, and only runs providers you explicitly enable. Install repositories and enable providers you trust.";
                color: Theme.text-muted;
                font-size: 0.72 * root.unit;
                wrap: word-wrap;
            }
        }
    }
}
