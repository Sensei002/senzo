import { ListView } from "std-widgets.slint";
import { Theme, IconData } from "../theme.slint";
import { ButtonSurface, ChevronTextButton, IconAction, PillButton } from "../components/button.slint";
import { EmptyState, SkeletonBlock } from "../components/feedback.slint";
import { Video, VideoPlaceholder } from "../components/media_rows.slint";
import { MetaPreview, MetaPreviewPlaceholder } from "../components/meta_preview.slint";
import { SelectField, SeasonSelectField } from "../components/select.slint";
import { SearchBar } from "../components/text_input.slint";
import { ToggleSwitch } from "../components/toggle.slint";
import { ModalDialog } from "../components/overlays.slint";
import { NumberInput } from "../components/number_input.slint";
import { SharePrompt } from "../components/share_prompt.slint";

export struct StreamLink {
    id: string,
    name: string,
    description: string,
    provider: string,
    source-system: string,
    thumbnail-url: string,
    thumbnail: image,
    progress: float,
    score: int,
    score-reasons: [string],
    score-summary: string,
    filtered: bool,
    group-start: bool,
    provider-count: int,
    seeders: int,
    // Resolution tag ("4K", "1080p", …) used when the source has no artwork.
    quality: string,
}

export struct EpisodeItem {
    id: string,
    title: string,
    released: string,
    thumbnail-url: string,
    thumbnail: image,
    season: int,
    episode-num: int,
    is-upcoming: bool,
    is-watched: bool,
    is-scheduled: bool,
    progress: float,
    can-play: bool,
}

// The source page mirrors the phone client: one compact header, two filters,
// and a flat ranked list. Play on the details page always lands here, so the
// old side drawer never competes with it for space.
component SourceRow inherits Rectangle {
    in property <length> unit: 16px;
    in property <string> name;
    in property <string> description;
    in property <string> provider;
    in property <string> quality;
    in property <string> source-system;
    in property <int> seeders;
    in property <bool> filtered;
    in property <string> score-label: "";
    in property <string> score-details: "";
    callback play;

    height: 6.3 * root.unit;
    background: area.has-hover ? Theme.overlay-hover : transparent;
    animate background { duration: Theme.motion-fast; }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.play(); }
    }

    Rectangle {
        x: 0.9 * root.unit;
        y: parent.height - 1px;
        width: parent.width - 1.8 * root.unit;
        height: 1px;
        background: Theme.card-border.with-alpha(0.65);
    }

    HorizontalLayout {
        x: 0.9 * root.unit;
        y: 0.65 * root.unit;
        width: parent.width - 1.8 * root.unit;
        height: parent.height - 1.3 * root.unit;
        spacing: 0.9 * root.unit;
        alignment: start;

        Rectangle {
            width: 4.2 * root.unit;
            height: 1.9 * root.unit;
            border-radius: self.height / 2;
            background: root.source-system != "" && root.source-system != "Direct"
                ? Theme.warning.with-alpha(0.16)
                : Theme.primary-accent.with-alpha(0.14);

            Text {
                width: parent.width;
                height: parent.height;
                text: root.quality == "" ? "FILE" : root.quality;
                color: root.source-system != "" && root.source-system != "Direct"
                    ? Theme.warning
                    : Theme.primary-accent;
                font-size: 0.66 * root.unit;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 0.15 * root.unit;

            Text {
                text: root.name;
                height: 1.5 * root.unit;
                color: Theme.text-primary;
                font-size: 0.95 * root.unit;
                font-weight: 650;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: root.description;
                height: 2.0 * root.unit;
                color: Theme.text-secondary;
                font-size: 0.79 * root.unit;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
            }

            HorizontalLayout {
                height: 1.1 * root.unit;
                spacing: 0.45 * root.unit;
                alignment: start;

                if (root.source-system != "" && root.source-system != "Direct") : Text {
                    width: 3.8 * root.unit;
                    text: "👤 " + root.seeders;
                    color: root.seeders == 0
                        ? Theme.danger
                        : (root.seeders < 25 ? Theme.warning : Theme.success);
                    font-size: 0.72 * root.unit;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.provider
                        + (root.source-system == "Direct" ? "  ·  Direct" : "  ·  P2P")
                        + (root.filtered ? "  ·  filtered" : "");
                    color: root.filtered ? Theme.warning : Theme.text-muted;
                    font-size: 0.7 * root.unit;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        Text {
            width: 3.4 * root.unit;
            height: parent.height;
            text: root.score-label;
            color: Theme.text-muted;
            font-size: 0.72 * root.unit;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component SourcesPage inherits Rectangle {
    in property <length> unit: 16px;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <[StreamLink]> streams: [];
    in property <[string]> providers: ["All"];
    in property <bool> busy: false;
    in property <int> pending: 0;
    in-out property <string> ranking-mode: "Smart";
    in-out property <bool> show-filtered: false;
    in-out property <string> provider: "All";
    private property <bool> provider-open: false;
    private property <bool> ranking-open: false;
    callback play(string);
    callback play-best;
    callback close;
    callback reload;
    callback ranking-changed(string);
    callback show-filtered-changed(bool);

    private property <length> pad: 2.5 * root.unit;
    private property <length> content-width: root.width - 2 * root.pad;
    private property <string> status-text: root.busy
        ? (root.streams.length == 0
            ? @tr("SOURCES_ARE_LOADING" => "Loading sources…")
            : (root.pending > 0
                ? root.pending + (root.pending == 1 ? " add-on still answering" : " add-ons still answering")
                : (root.streams.length == 1 ? "1 FILE" : root.streams.length + " FILES")))
        : (root.streams.length == 1 ? "1 FILE" : root.streams.length + " FILES");

    background: Theme.background;
    clip: true;

    HorizontalLayout {
        x: root.pad;
        y: 1.4 * root.unit;
        width: root.content-width;
        height: 3.4 * root.unit;
        spacing: 0.7 * root.unit;
        alignment: start;

        IconAction {
            width: 3.2 * root.unit;
            height: 3.4 * root.unit;
            unit: root.unit;
            icon-source: @image-url("../assets/images/icons/chevron-back.svg");
            label: @tr("BACK" => "Back");
            surface-color: transparent;
            clicked => { root.close(); }
        }

        Text {
            text: "SENZO SOURCES";
            color: Theme.text-primary;
            font-size: 0.8 * root.unit;
            font-weight: 750;
            letter-spacing: 0.12 * root.unit;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.status-text;
            color: Theme.text-muted;
            font-size: 0.7 * root.unit;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        if (root.streams.length > 0 && !root.busy) : PillButton {
            width: 9 * root.unit;
            height: 3.2 * root.unit;
            unit: root.unit;
            label: @tr("PLAY_BEST" => "Play best");
            primary: true;
            clicked => { root.play-best(); }
        }

        // The reload glyph itself turns while a reload runs. It is driven by
        // the renderer clock, so it stays smooth even while results stream in.
        ButtonSurface {
            width: 3.2 * root.unit;
            height: 3.4 * root.unit;
            accessible-name: @tr("RELOAD_SOURCES" => "Reload sources");
            background: self.has-hover ? Theme.overlay-hover : transparent;
            clicked => { root.reload(); }

            Image {
                width: 1.75 * root.unit;
                height: 1.75 * root.unit;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../assets/images/icons/rotate.svg");
                colorize: root.busy ? Theme.primary-accent : Theme.text-secondary;
                image-fit: contain;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-rotation: root.busy ? (animation-tick() / 900ms) * 360deg : 0deg;
            }
        }
    }

    Text {
        x: root.pad;
        y: 5.3 * root.unit;
        width: root.content-width;
        height: 2.2 * root.unit;
        text: root.title;
        color: Theme.text-primary;
        font-size: 1.4 * root.unit;
        font-weight: 750;
        vertical-alignment: center;
        overflow: elide;
    }

    if (root.subtitle != "") : Text {
        x: root.pad;
        y: 7.4 * root.unit;
        width: root.content-width;
        height: 1.3 * root.unit;
        text: root.subtitle;
        color: Theme.text-muted;
        font-size: 0.84 * root.unit;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        x: root.pad;
        y: 8.8 * root.unit;
        width: root.content-width;
        height: 2.7 * root.unit;
        spacing: 0.75 * root.unit;
        z: 10000;

        Rectangle {
            horizontal-stretch: 1;
            height: parent.height;

            SelectField {
                unit: root.unit;
                field-width: parent.width;
                value: root.provider;
                options: root.providers;
                open: root.provider-open;
                toggle => {
                    root.provider-open = !root.provider-open;
                    if (root.provider-open) {
                        root.ranking-open = false;
                    }
                }
                selected(provider) => {
                    root.provider = provider;
                    root.provider-open = false;
                }
            }
        }

        Rectangle {
            width: 10.5 * root.unit;
            height: parent.height;

            SelectField {
                unit: root.unit;
                field-width: parent.width;
                value: root.ranking-mode;
                options: ["Smart", "Quality", "Smallest", "Seeders", "Original"];
                open: root.ranking-open;
                toggle => {
                    root.ranking-open = !root.ranking-open;
                    if (root.ranking-open) {
                        root.provider-open = false;
                    }
                }
                selected(mode) => {
                    root.ranking-mode = mode;
                    root.ranking-open = false;
                    root.ranking-changed(mode);
                }
            }
        }
    }

    if (root.streams.length > 0) : HorizontalLayout {
        x: root.pad;
        y: 11.8 * root.unit;
        width: root.content-width;
        height: 1.9 * root.unit;
        spacing: 0.7 * root.unit;
        alignment: start;

        ToggleSwitch {
            unit: root.unit;
            checked <=> root.show-filtered;
            toggled => { root.show-filtered-changed(root.show-filtered); }
        }

        Text {
            horizontal-stretch: 1;
            text: @tr("STREAM_SHOW_FILTERED" => "Show suspicious or filtered sources");
            color: Theme.text-secondary;
            font-size: 0.86 * root.unit;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if (root.streams.length == 0) : VerticalLayout {
        x: root.pad;
        y: 12.2 * root.unit;
        width: root.content-width;
        height: parent.height - 13.2 * root.unit;
        alignment: center;
        spacing: 1.1 * root.unit;

        if (root.busy) : Rectangle {
            width: 3 * root.unit;
            height: 3 * root.unit;

            Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("../assets/images/icons/rotate.svg");
                colorize: Theme.primary-accent;
                image-fit: contain;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-rotation: (animation-tick() / 900ms) * 360deg;
            }
        }

        Text {
            text: root.busy
                ? @tr("SOURCES_ARE_LOADING" => "Loading sources…")
                : @tr("NO_STREAM" => "No streams were found");
            color: Theme.text-primary;
            font-size: 1.15 * root.unit;
            font-weight: 650;
            horizontal-alignment: center;
        }

        if (root.busy) : Text {
            text: @tr("SOURCES_LOADING_HINT" => "Asking every enabled add-on and plugin for a source.");
            color: Theme.text-muted;
            font-size: 0.84 * root.unit;
            horizontal-alignment: center;
        }

        if (!root.busy) : PillButton {
            width: 13 * root.unit;
            height: 3.2 * root.unit;
            unit: root.unit;
            label: @tr("RELOAD_SOURCES" => "Reload sources");
            show-icon: true;
            icon-source: @image-url("../assets/images/icons/rotate.svg");
            clicked => { root.reload(); }
        }
    }

    if (root.streams.length > 0) : ListView {
        x: root.pad;
        y: 13.8 * root.unit;
        width: root.content-width;
        height: parent.height - 14.8 * root.unit;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

        for stream in root.streams : stream-delegate := Rectangle {
            private property <bool> matches-provider:
                root.provider == "All" || stream.provider == root.provider;
            width: root.content-width;
            height: self.matches-provider ? 6.3 * root.unit : 0px;
            clip: true;
            background: transparent;

            SourceRow {
                visible: stream-delegate.matches-provider;
                width: parent.width;
                height: 6.3 * root.unit;
                unit: root.unit;
                name: stream.name;
                description: stream.description;
                source-system: stream.source-system;
                provider: stream.provider;
                quality: stream.quality;
                seeders: stream.seeders;
                filtered: stream.filtered;
                score-label: root.ranking-mode == "Original" || stream.score == 0
                    ? ""
                    : (stream.score > 0 ? "+" + stream.score : "" + stream.score);
                score-details: stream.score-summary;
                play => { root.play(stream.id); }
            }
        }
    }
}

export component DetailsPage inherits Rectangle {
    width: 1280px;
    height: 720px;
    in property <string> item-title: "";
    in property <image> logo;
    in property <string> description: "";
    in property <image> poster;
    in property <image> background-image;
    in property <string> release-year: "";
    in property <string> runtime: "";
    in property <string> rating: "";
    in property <string> rt-rating: "";
    in property <string> metacritic-rating: "";
    in property <string> letterboxd-rating: "";
    in property <string> anilist-rating: "";
    in property <string> kitsu-rating: "";
    in property <[string]> genres: [];
    in property <[string]> cast: [];
    in property <[string]> directors: [];
    in property <string> enrichment-summary: "";
    in property <string> enrichment-attribution-url: "";
    callback open-attribution(string);
    in property <[StreamLink]> streams: [];
    in property <[string]> stream-providers: ["All"];
    in property <int> stream-loading-count: 0;
    // The backend keeps this true for the whole provider round-trip. The
    // count above only flips while a plugin request is actively in flight,
    // which is too brief to see on a warm cache.
    in property <bool> sources-loading-pending: false;
    private property <bool> source-spinner-hold: true;
    private property <bool> source-spinner-cap: true;

    Timer {
        interval: 700ms;
        running: root.source-spinner-hold;
        triggered => { root.source-spinner-hold = false; }
    }

    Timer {
        interval: 15s;
        running: root.sources-loading-pending;
        triggered => {
            root.source-spinner-cap = false;
            root.source-spinner-hold = false;
        }
    }

    changed sources-loading-pending => {
        if (root.sources-loading-pending) {
            root.source-spinner-hold = true;
            root.source-spinner-cap = true;
        }
    }

    changed item-title => {
        root.source-spinner-hold = true;
        root.source-spinner-cap = true;
        // A new title must not inherit the previous source page.
        root.sources-page-open = false;
    }

    private property <bool> sources-loading-active:
        (root.sources-loading-pending && root.source-spinner-cap)
        || root.source-spinner-hold
        || root.stream-loading-count > 0;

    in-out property <string> active-stream-provider: "All";
    in-out property <string> ranking-mode: "Smart";
    in-out property <bool> show-filtered: false;
    in property <bool> loading: false;
    in property <bool> is-in-library: false;
    in property <bool> is-watched: false;
    in property <bool> has-trailer: false;
    in property <string> trailer-selection-id: "";
    callback toggle-library;
    callback toggle-watched;
    callback play-trailer(string);
    in property <bool> is-series: false;
    in property <[int]> available-seasons: [];
    in-out property <int> active-season: 1;
    in-out property <bool> season-menu-open: false;
    in-out property <bool> notifications-enabled: true;
    in property <[string]> episode-names: [];
    in-out property <int> active-episode-idx: 0;
    in property <[EpisodeItem]> episodes: [];
    in-out property <bool> in-stream-view: false;
    // Play opens this dedicated source page instead of playing immediately.
    in-out property <bool> sources-page-open: false;
    in-out property <string> episode-search-query: "";
    in property <string> username: "";
    in property <image> avatar-image;
    in property <bool> has-avatar-image: false;
    in property <image> default-avatar-icon;
    in property <image> anonymous-icon;
    callback toggle-fullscreen;
    callback season-changed(int);
    callback season-step(int);
    callback notifications-changed(bool);
    callback episode-changed(int, string);
    callback toggle-episode-watched(string);
    callback episode-search-changed(string);
    callback copy-stream-link(string);
    callback copy-magnet-link(string);
    callback copy-download-link(string);
    callback toggle-season-watched(int);
    callback manual-episode-selected(int, int);
    callback open-addons;
    callback share-copy(string);
    callback share-social(string, string);
    callback ranking-mode-changed(string);
    callback show-filtered-changed(bool);
    in property <string> share-url: "";
    in-out property <bool> share-modal-open: false;
    private property <bool> stream-context-open: false;
    private property <length> stream-context-x: 0px;
    private property <length> stream-context-y: 0px;
    private property <string> stream-context-id: "";
    in-out property <int> manual-season: root.active-season;
    in-out property <int> manual-episode: 1;
    in property <IconData> icon-play;
    in property <IconData> icon-link;
    in property <IconData> icon-magnet;
    in property <IconData> icon-download;
    in property <IconData> icon-eye;
    in property <IconData> icon-eye-off;
    in property <IconData> icon-clapperboard;
    callback play-stream(string);
    callback reload-sources;
    callback close;

    in property <length> unit: Theme.root-font-size;
    property <length> drawer-width: min(40 * root.unit, root.width * 0.52);
    in-out property <bool> ranking-filter-open: false;
    in-out property <bool> provider-filter-open: false;
    changed streams => { root.active-stream-provider = "All"; }
    private property <int> first-season: root.available-seasons.length > 0
        ? root.available-seasons[0] : root.active-season;
    private property <int> last-season: root.available-seasons.length > 0
        ? root.available-seasons[root.available-seasons.length - 1] : root.active-season;
    // Minimum for the season pill; it sizes to its own label beyond this.
    private property <length> season-button-width: 10 * root.unit;

    background: Theme.modal-background;
    clip: true;

    if (root.background-image.width > 0) : Image {
        width: parent.width;
        height: parent.height;
        source: root.background-image;
        image-fit: cover;
        horizontal-alignment: right;
        opacity: 0.3;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.background.with-alpha(0.18);
    }

    // Navigation must remain available while metadata or streams are loading.
    IconAction {
        x: root.unit;
        y: root.unit;
        width: 3.5 * root.unit;
        height: 3.5 * root.unit;
        unit: root.unit;
        icon-source: @image-url("../assets/images/icons/chevron-back.svg");
        accessible-name: @tr("BACK" => "Back");
        surface-color: transparent;
        z: 10;
        clicked => { root.close(); }
    }

    if (root.loading) : Rectangle {
        MetaPreviewPlaceholder {
            x: 4 * root.unit;
            y: 8 * root.unit;
            width: parent.width - root.drawer-width - 8 * root.unit;
            height: parent.height - 10 * root.unit;
            unit: root.unit;
        }

        Rectangle {
            x: parent.width - root.drawer-width;
            y: 6 * root.unit;
            width: root.drawer-width;
            height: parent.height - 6 * root.unit;
            border-radius: Theme.border-radius;
            background: Theme.drawer-background;

            VerticalLayout {
                padding-top: 1.5 * root.unit;
                padding-left: 1.5 * root.unit;
                padding-right: 1.5 * root.unit;
                padding-bottom: 0.75 * root.unit;
                spacing: root.unit;

                SkeletonBlock {
                    height: 3.5 * root.unit;
                    radius: self.height / 2;
                }

                for _video in [0, 1, 2, 3, 4] : VideoPlaceholder {
                    horizontal-stretch: 1;
                    unit: root.unit;
                    has-thumbnail: false;
                }
            }
        }
    }

    if (!root.loading) : Rectangle {
        x: 0px;
        width: parent.width - (root.is-series ? root.drawer-width : 0px);
        height: parent.height;
        background: transparent;
        clip: true;

        MetaPreview {
            x: 4 * root.unit;
            y: 5.5 * root.unit;
            width: parent.width - 8 * root.unit;
            height: parent.height - 7.5 * root.unit;
            unit: root.unit;
            name: root.item-title;
            logo: root.logo;
            runtime: root.runtime;
            release-info: root.release-year;
            imdb-label: root.rating;
            rt-rating: root.rt-rating;
            metacritic-rating: root.metacritic-rating;
            letterboxd-rating: root.letterboxd-rating;
            anilist-rating: root.anilist-rating;
            kitsu-rating: root.kitsu-rating;
            description: root.description;
            genres: root.genres;
            cast: root.cast;
            directors: root.directors;
            show-trailer: root.has-trailer && root.trailer-selection-id != "";
            show-play: true;
            show-library-actions: true;
            in-library: root.is-in-library;
            watched: root.is-watched;
            show-ratings: true;
            show-share: true;
            trailer-requested => { root.play-trailer(root.trailer-selection-id); }
            play-requested => {
                if (root.is-series && root.episodes.length > 0) {
                    if (root.active-episode-idx < 0 || root.active-episode-idx >= root.episodes.length) {
                        root.active-episode-idx = 0;
                    }
                    root.episode-changed(
                        root.active-episode-idx,
                        root.episodes[root.active-episode-idx].id,
                    );
                }
                root.sources-page-open = true;
            }
            library-requested(_in-library) => { root.toggle-library(); }
            watched-requested(_watched) => { root.toggle-watched(); }
            share-requested => { root.share-modal-open = true; }
        }
    }

    if (!root.loading && root.enrichment-summary != "") : ButtonSurface {
        x: 4 * root.unit;
        y: parent.height - 3.5 * root.unit;
        width: parent.width - (root.is-series ? root.drawer-width : 0px) - 8 * root.unit;
        height: 2.5 * root.unit;
        border-radius: 1.25 * root.unit;
        background: self.has-hover ? Theme.overlay-hover : Theme.overlay-color;
        accessible-name: root.enrichment-summary;
        clicked => {
            if (root.enrichment-attribution-url != "") {
                root.open-attribution(root.enrichment-attribution-url);
            }
        }
        Text {
            width: parent.width - 2 * root.unit;
            x: root.unit;
            height: parent.height;
            text: root.enrichment-summary;
            color: Theme.text-secondary;
            font-size: 0.85 * root.unit;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Series keep a fixed episode rail on the right. Movies never show a
    // rail: Play opens the dedicated source page instead, so the details view
    // stays clean and the old inline source drawer cannot open again.
    if (!root.loading && root.is-series) : Rectangle {
        x: parent.width - root.drawer-width;
        y: 6 * root.unit;
        width: root.drawer-width;
        height: parent.height - 6 * root.unit;
        border-top-left-radius: Theme.border-radius;
        border-bottom-left-radius: Theme.border-radius;
        background: Theme.drawer-background;
        clip: true;

        // Base inset is the web's 1rem, shared by `.videos-container`,
        // `.streams-container` and `.select-choices-wrapper`. Sections the web
        // insets further (notifications, search bar, seasons bar) add their own
        // padding on top of this.
        VerticalLayout {
            padding-top: 1.5 * root.unit;
            padding-left: root.unit;
            padding-right: root.unit;
            padding-bottom: 0.75 * root.unit;
            spacing: 0.75 * root.unit;

            HorizontalLayout {
                height: 2.4 * root.unit;
                spacing: 0.6 * root.unit;
                alignment: start;

                Text {
                    text: @tr("EPISODES" => "EPISODES");
                    color: Theme.text-primary;
                    font-size: 0.78 * root.unit;
                    font-weight: 750;
                    letter-spacing: 0.12 * root.unit;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.episodes.length == 1 ? "1 EPISODE" : root.episodes.length + " EPISODES";
                    color: Theme.text-muted;
                    font-size: 0.68 * root.unit;
                    font-weight: 650;
                    vertical-alignment: center;
                }
            }

            if (root.is-series && root.is-in-library) : Rectangle {
                height: 2.8 * root.unit;
                background: transparent;

                ToggleSwitch {
                    x: 0.5 * root.unit;
                    y: (parent.height - self.height) / 2;
                    unit: root.unit;
                    checked <=> root.notifications-enabled;
                    toggled => { root.notifications-changed(root.notifications-enabled); }
                }

                Text {
                    x: 4.7 * root.unit;
                    y: 0px;
                    width: parent.width - self.x - 0.5 * root.unit;
                    height: parent.height;
                    text: @tr("DETAIL_RECEIVE_NOTIF_SERIES" => "Receive notifications for new episodes");
                    color: Theme.surface-light-90;
                    font-size: root.unit;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if (root.is-series && root.available-seasons.length > 0) : Rectangle {
                height: 4 * root.unit;
                background: transparent;
                z: 10000;

                // The web's `.seasons-bar-container` is a `space-between` row
                // inset a further 1rem (margin) inside its own 1rem padding, so
                // the pill stays centred whatever width its label needs.
                HorizontalLayout {
                    padding-left: root.unit;
                    padding-right: root.unit;
                    padding-top: 0.5 * root.unit;
                    padding-bottom: 0.5 * root.unit;
                    alignment: space-between;

                    ChevronTextButton {
                        unit: root.unit;
                        label: @tr("Prev");
                        icon-source: @image-url("../assets/images/icons/chevron-back.svg");
                        enabled: root.active-season != root.first-season;
                        clicked => { root.season-step(-1); }
                    }

                    SeasonSelectField {
                        unit: root.unit;
                        field-width: root.season-button-width;
                        value: root.active-season;
                        options: root.available-seasons;
                        open: root.season-menu-open;
                        toggle => { root.season-menu-open = !root.season-menu-open; }
                        selected(season) => {
                            root.active-season = season;
                            root.season-menu-open = false;
                            root.season-changed(season);
                        }
                    }

                    ChevronTextButton {
                        unit: root.unit;
                        label: @tr("Next");
                        trailing-icon: true;
                        icon-source: @image-url("../assets/images/icons/chevron-forward.svg");
                        enabled: root.active-season != root.last-season;
                        clicked => { root.season-step(1); }
                    }
                }

                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: @tr("MARK_SEASON_WATCHED" => "Mark season as watched / unwatched");
                            activated => { root.toggle-season-watched(root.active-season); }
                        }
                    }
                }
            }

            // `.search-bar { margin: 0 1.5rem 1rem 1.5rem }` — 0.5rem beyond the
            // container's own inset.
            if (root.is-series) : HorizontalLayout {
                height: 3 * root.unit;
                padding-left: 0.5 * root.unit;
                padding-right: 0.5 * root.unit;

                SearchBar {
                    horizontal-stretch: 1;
                    unit: root.unit;
                    text <=> root.episode-search-query;
                    title: @tr("SEARCH_VIDEOS" => "search videos");
                    edited => { root.episode-search-changed(root.episode-search-query); }
                }
            }


            if (root.is-series) : ListView {
                vertical-stretch: 1;
                for episode[index] in root.episodes : Video {
                    width: parent.width;
                    unit: root.unit;
                    title: episode.title;
                    released: episode.released;
                    thumbnail: episode.thumbnail;
                    episode-number: episode.episode-num;
                    upcoming: episode.is-upcoming;
                    watched: episode.is-watched;
                    scheduled: episode.is-scheduled;
                    progress: episode.progress;
                    selected => {
                        root.active-episode-idx = index;
                        root.episode-changed(index, episode.id);
                        root.sources-page-open = true;
                    }
                    toggle-watched => { root.toggle-episode-watched(episode.id); }
                }
            }



        }
    }

    // Anchored on window coordinates taken from the row's `absolute-position`,
    // so it has to span the page to clamp correctly. It also must not be a child
    // of the drawer's VerticalLayout: an overlay still claims a layout slot
    // there, which is what left a blank band under the list.

    if (!root.loading) : HorizontalLayout {
        x: parent.width - 11 * root.unit;
        y: root.unit;
        height: 3.5 * root.unit;
        spacing: 0.5 * root.unit;
        alignment: start;
        z: 50;

        IconAction {
            width: 3.5 * root.unit;
            height: 3.5 * root.unit;
            unit: root.unit;
            border-radius: 0.75 * root.unit;
            icon-size: 2 * root.unit;
            icon-source: @image-url("../assets/images/icons/maximize.svg");
            label: @tr("SETTINGS_SHORTCUT_FULLSCREEN" => "Toggle Fullscreen");
            surface-color: transparent;
            clicked => { root.toggle-fullscreen(); }
        }

        Rectangle {
            width: 3.5 * root.unit;
            border-radius: 0.75 * root.unit;
            background: transparent;
            Rectangle {
                x: 0.55 * root.unit;
                y: 0.55 * root.unit;
                width: 2.4 * root.unit;
                height: 2.4 * root.unit;
                background: Theme.accent;
                border-radius: self.width / 2;
                border-width: 0.15 * root.unit;
                border-color: Theme.accent;
                clip: true;

                if (root.username == "" || root.username == "Guest") : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.anonymous-icon;
                    image-fit: cover;
                }
                if (root.username != "" && root.username != "Guest" && root.has-avatar-image) : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.avatar-image;
                    image-fit: cover;
                }
                if (root.username != "" && root.username != "Guest" && !root.has-avatar-image) : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.default-avatar-icon;
                    image-fit: cover;
                }
            }
        }
    }

    // The dedicated source page covers the whole details view so Play leads
    // somewhere deliberate rather than starting the first ranked source.
    if (root.sources-page-open) : SourcesPage {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        z: 400;
        unit: root.unit;
        title: root.item-title;
        subtitle: root.is-series && root.episode-names.length > root.active-episode-idx
            ? root.episode-names[root.active-episode-idx]
            : (root.is-series
                ? @tr("ALL_EPISODE_SOURCES" => "Episode sources")
                : @tr("ALL_SOURCES_HINT" => "Every source for this title, ranked and ready to play."));
        streams: root.streams;
        providers: root.stream-providers;
        busy: root.sources-loading-active;
        pending: root.stream-loading-count;
        ranking-mode: root.ranking-mode;
        show-filtered: root.show-filtered;
        play(id) => { root.play-stream(id); }
        play-best => {
            if (root.streams.length > 0) {
                root.play-stream(root.streams[0].id);
            }
        }
        close => { root.sources-page-open = false; }
        reload => { root.reload-sources(); }
        ranking-changed(mode) => {
            root.ranking-mode = mode;
            root.ranking-mode-changed(mode);
        }
        show-filtered-changed(show) => {
            root.show-filtered = show;
            root.show-filtered-changed(show);
        }
    }
    ModalDialog {
        width: 100%;
        height: 100%;
        z: 2000;
        unit: root.unit;
        open: root.share-modal-open;
        title: @tr("SHARE" => "Share");
        dialog-width: 36 * root.unit;
        dialog-height: 17 * root.unit;
        close-requested => { root.share-modal-open = false; }

        SharePrompt {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            unit: root.unit;
            url: root.share-url;
            copy-requested(url) => { root.share-copy(url); }
            share-requested(platform, url) => { root.share-social(platform, url); }
        }
    }

}